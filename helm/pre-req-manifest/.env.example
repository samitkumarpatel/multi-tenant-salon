# Copy this file to .env and fill in the values, then source it before running create-secrets.sh:
#   cp helm/pre-req-manifest/.env.example helm/pre-req-manifest/.env
#   source helm/pre-req-manifest/.env
#   ./helm/pre-req-manifest/create-secrets.sh
#
# Never commit .env — it contains real secrets.

# PostgreSQL password for the salon database.
# Used by the postgres pod and injected into api/auth pods at runtime.
POSTGRES_PASSWORD=

# GitHub username that owns the GHCR packages.
GHCR_USER=

# GitHub Personal Access Token with read:packages scope (NOT GITHUB_TOKEN — it expires).
# Create one at: github.com/settings/tokens
GHCR_PAT=
