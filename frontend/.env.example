# Frontend env (Vite). All optional — defaults shown.
# Per app: cp frontend/.env.example frontend/apps/<app>/.env

VITE_API_BASE_URL=http://localhost:8080
VITE_SALON_DOMAIN=salonsaas.org

# "mock" (dev default) or "oauth2" (prod default)
VITE_AUTH_MODE=mock
VITE_AUTH_SERVER_URL=https://auth.salonsaas.org
VITE_AUTH_CLIENT_ID=salon-admin
VITE_AUTH_SCOPE=openid profile

# Cross-app links (prod default: https://<sub>.${VITE_SALON_DOMAIN})
VITE_ADMIN_APP_URL=http://localhost:5173
VITE_WEBSITE_BASE_URL=http://localhost:5174
VITE_SUPER_ADMIN_APP_URL=http://localhost:5176
VITE_BOOKING_APP_URL=http://localhost:5177
VITE_STAFF_APP_URL=http://localhost:5178
