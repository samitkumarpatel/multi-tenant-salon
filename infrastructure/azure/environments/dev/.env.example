# =============================================================================
# Terraform — Azure provider authentication (local development / CI bootstrap)
# =============================================================================
# Used by the AzureRM provider when running terraform locally.

ARM_CLIENT_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_SECRET=your-service-principal-client-secret
ARM_TENANT_ID=00000000-0000-0000-0000-000000000000
ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# =============================================================================
# GitHub Actions — Secrets (Settings → Secrets → Actions)
# =============================================================================

# -- Azure ---------------------------------------------------------------------
AZURE_CREDENTIALS={"clientId":"...","clientSecret":"...","subscriptionId":"...","tenantId":"..."}
# Service principal JSON. Generate with:
#   az ad sp create-for-rbac --name "github-actions-salon" \
#     --role Contributor \
#     --scopes /subscriptions/<SUBSCRIPTION_ID> \
#     --sdk-auth

# -- AWS (existing frontend deploy workflows) ----------------------------------
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# =============================================================================
# GitHub Actions — Variables (Settings → Variables → Actions)
# =============================================================================
# Non-secret configuration referenced as ${{ vars.* }} in workflows.

# -- Shared Azure infrastructure -----------------------------------------------
AZURE_RESOURCE_GROUP=multi-tenant-salon-dev
AZURE_CDN_PROFILE=my-salon-dev-cdn

# -- Per-app Azure variables ---------------------------------------------------
# Set AZURE_STORAGE_ACCOUNT and AZURE_CDN_ENDPOINT per app.
# Use GitHub environment-level variables (one environment per app) or
# repository-level variables with app-specific names.

# salon-admin
#   AZURE_STORAGE_ACCOUNT = mysalondevadmin
#   AZURE_CDN_ENDPOINT    = admin-web

# salon-staff
#   AZURE_STORAGE_ACCOUNT = mysalondevstaff
#   AZURE_CDN_ENDPOINT    = staff-web

# salon-booking
#   AZURE_STORAGE_ACCOUNT = mysalondevbooking
#   AZURE_CDN_ENDPOINT    = booking-web

# salon-onboarding
#   AZURE_STORAGE_ACCOUNT = mysalondevonboarding
#   AZURE_CDN_ENDPOINT    = onboarding-web

# salon-public-website
#   AZURE_STORAGE_ACCOUNT = mysalondevpublic
#   AZURE_CDN_ENDPOINT    = public-web

# salon-super-admin
#   AZURE_STORAGE_ACCOUNT = mysalondevsuperadmin
#   AZURE_CDN_ENDPOINT    = super-admin-web

# -- Frontend build-time environment variables ---------------------------------
VITE_API_BASE_URL=https://api.salonsaas.org
VITE_SALON_DOMAIN=salonsaas.org
VITE_BOOKING_BASE_URL=https://book.salonsaas.org
VITE_ADMIN_APP_URL=https://admin.salonsaas.org
