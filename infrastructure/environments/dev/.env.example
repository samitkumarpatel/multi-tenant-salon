# Copy this file to .env and fill in real values before running terraform apply.

# AWS credentials
AWS_PROFILE=default

# S3 remote state backend
TF_BACKEND_BUCKET=my-saloon-terraform-state
TF_BACKEND_KEY=dev/1.0.0/terraform.tfstate
TF_BACKEND_REGION=ap-south-1
TF_BACKEND_DYNAMODB_TABLE=terraform-locks

# GHCR pull credentials — PAT requires read:packages scope.
# Value MUST be single-quoted so the shell preserves the JSON structure.
TF_VAR_ghcr_token='{"username":"<github-username>","password":"<ghp_personalAccessToken>"}'
