# Terraform — `mix` environment. Source before running terraform in this dir:
#   set -a && . ./.env && set +a

# Azure provider auth (AzureRM + AzAPI)
ARM_CLIENT_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_SECRET=your-sp-client-secret
ARM_TENANT_ID=00000000-0000-0000-0000-000000000000
ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Cloudflare provider auth (token: Pages Edit + Zone Edit + DNS Edit + create zones)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Required TF vars
TF_VAR_cloudflare_account_id=your-cloudflare-account-id
TF_VAR_ghcr_token=ghp_xxx_read_packages_pat
TF_VAR_mailjet_api_key=your-mailjet-api-key
TF_VAR_mailjet_api_secret=your-mailjet-api-secret
TF_VAR_anthropic_api_key=sk-ant-xxx

# Optional TF vars (defaults shown)
#TF_VAR_azure_resource_group=multi-tenant-salon-mix
#TF_VAR_azure_location=westeurope
#TF_VAR_bind_custom_domains=false
# Enable Cloudflare for SaaS on the zone first. Runtime token is separate from Terraform credentials.
#TF_VAR_website_domains_enabled=true
#TF_VAR_website_domains_api_token=zone-scoped-ssl-and-certificates-write-token
# key_vault_admin_object_ids is hardcoded in environments/mix/main.tf, not a TF_VAR.
# list(string)/map(string) TF_VARs need their JSON single-quote-wrapped at the shell
# level, or `. ./.env` strips the double quotes and Terraform fails to parse it:
#TF_VAR_postgres_client_ips='{"laptop":"203.0.113.7"}'
