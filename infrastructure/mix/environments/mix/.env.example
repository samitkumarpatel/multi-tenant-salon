# =============================================================================
# Terraform - `mix` environment (Cloudflare Pages + Azure Container Apps + Azure DNS)
# =============================================================================
# Source this file (or export the vars) before running terraform in this dir.

# -- Azure provider auth (AzureRM + AzAPI) ------------------------------------
ARM_CLIENT_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_SECRET=your-service-principal-client-secret
ARM_TENANT_ID=00000000-0000-0000-0000-000000000000
ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# -- Cloudflare provider auth ------------------------------------------------
# API token needs: Account > Cloudflare Pages > Edit
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# -- Terraform input variables ---------------------------------------------
TF_VAR_cloudflare_account_id=your-cloudflare-account-id
TF_VAR_ghcr_token=ghp_xxx_read_packages_pat
# Shared Azure resource group (holds the DNS zone + mix's Container Apps/Key Vault).
# Defaults to multi-tenant-salon-dev; must match azure/environments/dev.
#TF_VAR_azure_resource_group=multi-tenant-salon-dev
# Leave false for the first apply; set true for the second apply once the
# asuid/CNAME records have propagated.
TF_VAR_bind_custom_domains=false

# =============================================================================
# GitHub Actions - repository secrets used by the deploy-* workflows
# =============================================================================
# AZURE_CREDENTIALS       - SP JSON (az ad sp create-for-rbac --sdk-auth)
# CLOUDFLARE_API_TOKEN    - same token as above (Pages: Edit)
# CLOUDFLARE_ACCOUNT_ID   - Cloudflare account ID
#
# GitHub Actions - variables (per-app build-time)
# VITE_API_BASE_URL_MIX      = https://api-m.salonsaas.org
# VITE_SALON_DOMAIN_MIX      = salonsaas.org
# VITE_BOOKING_BASE_URL_MIX  = https://book-m.salonsaas.org
