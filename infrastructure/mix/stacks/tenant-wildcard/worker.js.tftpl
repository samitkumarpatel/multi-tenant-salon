// Reverse-proxy every tenant sub-domain (<salon>.<zone>) onto the
// salon-public-website Cloudflare Pages deployment.
//
// Cloudflare Pages cannot hold a wildcard custom domain, so a proxied wildcard
// DNS record plus this Worker (route "*.<zone>/*") stand in for one. The
// visitor's Host is forwarded as X-Forwarded-Host so the SPA can resolve which
// salon it is serving. Redirects that point back at the pages.dev origin are
// rewritten to the tenant host so the visitor never leaves <salon>.<zone>.
//
// Generated by Terraform (infrastructure/mix/stacks/tenant-wildcard) — editing
// this Worker in the dashboard is pointless, the next `terraform apply`
// overwrites it.

const PAGES_HOST = "${pages_host}";
const PLATFORM_DOMAIN = "${zone_name}";
const API_BASE = "${api_base_url}";
const CUSTOM_DOMAINS_ENABLED = ${custom_domains_enabled};

export default {
  async fetch(request) {
    const tenantHost = new URL(request.url).hostname;

    // Only verified, active mappings may serve a customer domain. Never infer
    // a salon from the first label of a third-party hostname. No mapping cache:
    // disconnecting a domain must take effect before serving the next request.
    if (tenantHost !== PLATFORM_DOMAIN && !tenantHost.endsWith("." + PLATFORM_DOMAIN)) {
      if (!CUSTOM_DOMAINS_ENABLED) return unavailable(404);
      try {
        const resolution = await fetch(API_BASE + "/api/salon/domain/resolve?hostname=" + encodeURIComponent(tenantHost), {
          headers: { Accept: "application/json" },
          redirect: "error",
          signal: AbortSignal.timeout(10000),
          cf: { cacheTtl: 0, cacheEverything: false },
        });
        if (!resolution.ok) return unavailable(resolution.status === 404 ? 404 : 503);
        const mapping = await resolution.json();
        if (mapping.hostname !== tenantHost || !mapping.salonId) return unavailable(404);
      } catch { return unavailable(503); }
    }

    if (new URL(request.url).protocol !== "https:") {
      const secure = new URL(request.url);
      secure.protocol = "https:";
      return Response.redirect(secure.toString(), 308);
    }

    const upstream = new URL(request.url);
    upstream.hostname = PAGES_HOST;
    upstream.protocol = "https:";
    upstream.port = "";

    const proxied = new Request(upstream, request);
    proxied.headers.set("X-Forwarded-Host", tenantHost);
    proxied.headers.set("X-Forwarded-Proto", "https");

    const response = await fetch(proxied, { redirect: "manual" });

    const location = response.headers.get("location");
    if (location) {
      const rewritten = new URL(location, upstream);
      if (rewritten.hostname === PAGES_HOST) {
        rewritten.hostname = tenantHost;
        const headers = new Headers(response.headers);
        headers.set("location", rewritten.toString());
        return new Response(response.body, {
          status: response.status,
          statusText: response.statusText,
          headers: headers,
        });
      }
    }

    return response;
  },
};

function unavailable(status) {
  return new Response("This website is currently unavailable. Please try again later.", {
    status,
    headers: { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" },
  });
}
