// Reverse-proxy every tenant sub-domain (<salon>.<zone>) onto the
// salon-public-website Cloudflare Pages deployment.
//
// Cloudflare Pages cannot hold a wildcard custom domain, so a proxied wildcard
// DNS record plus this Worker (route "*.<zone>/*") stand in for one. The
// visitor's Host is forwarded as X-Forwarded-Host so the SPA can resolve which
// salon it is serving. Redirects that point back at the pages.dev origin are
// rewritten to the tenant host so the visitor never leaves <salon>.<zone>.
//
// Generated by Terraform (infrastructure/mix/stacks/tenant-wildcard) — editing
// this Worker in the dashboard is pointless, the next `terraform apply`
// overwrites it.

const PAGES_HOST = "${pages_host}";

export default {
  async fetch(request) {
    const tenantHost = new URL(request.url).hostname;

    const upstream = new URL(request.url);
    upstream.hostname = PAGES_HOST;
    upstream.protocol = "https:";
    upstream.port = "";

    const proxied = new Request(upstream, request);
    proxied.headers.set("X-Forwarded-Host", tenantHost);
    proxied.headers.set("X-Forwarded-Proto", "https");

    const response = await fetch(proxied, { redirect: "manual" });

    const location = response.headers.get("location");
    if (location) {
      const rewritten = new URL(location, upstream);
      if (rewritten.hostname === PAGES_HOST) {
        rewritten.hostname = tenantHost;
        const headers = new Headers(response.headers);
        headers.set("location", rewritten.toString());
        return new Response(response.body, {
          status: response.status,
          statusText: response.statusText,
          headers: headers,
        });
      }
    }

    return response;
  },
};
