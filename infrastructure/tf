#!/usr/bin/env bash
# Wrapper: sources environments/<ENV>/.env, then runs terraform against stacks/<STACK>.
# Usage: STACK=frontend ENV=dev ./tf plan
#        STACK=backend  ENV=dev ./tf apply -auto-approve
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
STACK="${STACK:-backend}"
ENV="${ENV:-dev}"

STACK_DIR="$SCRIPT_DIR/stacks/$STACK"
ENV_DIR="$SCRIPT_DIR/environments/$ENV"
ENV_FILE="$ENV_DIR/.env"
TFVARS_FILE="$ENV_DIR/$STACK.tfvars"

if [ ! -d "$STACK_DIR" ]; then
  echo "Error: stack '$STACK' not found. Available: $(ls "$SCRIPT_DIR/stacks" | tr '\n' ' ')" >&2
  exit 1
fi

if [ ! -d "$ENV_DIR" ]; then
  echo "Error: environment '$ENV' not found. Available: $(ls "$SCRIPT_DIR/environments" | tr '\n' ' ')" >&2
  exit 1
fi

if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
else
  echo "Warning: $ENV_FILE not found — copy .env.example to .env and fill in values" >&2
fi

# 'terraform init' and 'terraform fmt' do not accept -var-file.
FIRST_ARG="${1:-}"
VARFILE_ARG=""
if [ -f "$TFVARS_FILE" ] && \
   [ "$FIRST_ARG" != "init" ] && \
   [ "$FIRST_ARG" != "fmt" ] && \
   [ "$FIRST_ARG" != "version" ] && \
   [ "$FIRST_ARG" != "providers" ]; then
  VARFILE_ARG="-var-file=$TFVARS_FILE"
fi

exec terraform -chdir="$STACK_DIR" "$@" $VARFILE_ARG
