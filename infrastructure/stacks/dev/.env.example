# ── AWS credentials ───────────────────────────────────────────────────────────
# Option A: named profile (recommended)
AWS_PROFILE=default
# Option B: explicit keys (CI / no profile available)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=     # if using temporary credentials

# ── Terraform state backend ───────────────────────────────────────────────────
# Fill the backend "s3" block in providers.tf with these values, OR pass them
# via: ./tf init -backend-config="bucket=$TF_BACKEND_BUCKET" ...
TF_BACKEND_BUCKET=my-saloon-terraform-state
TF_BACKEND_KEY=dev/terraform.tfstate
TF_BACKEND_REGION=ap-south-1
TF_BACKEND_DYNAMODB_TABLE=terraform-locks

# ── Terraform input variables (TF_VAR_ prefix is picked up automatically) ────

# ACM certificate for api.my-saloon.online in ap-south-1 (ALB region).
# Request via: aws acm request-certificate --domain-name api.my-saloon.online --region ap-south-1
TF_VAR_api_acm_certificate_arn=arn:aws:acm:ap-south-1:ACCOUNT_ID:certificate/CERT_ID

# GitHub Container Registry credentials for pulling ghcr.io images.
# Create a PAT at https://github.com/settings/tokens with read:packages scope.
TF_VAR_ghcr_username=samitkumarpatel
TF_VAR_ghcr_pat=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
