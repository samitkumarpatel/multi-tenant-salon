{
  "family": "my-saloon-dev-api",
  "cpu": "512",
  "memory": "1024",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::257222191091:role/my-saloon-dev-api-exec-role",
  "taskRoleArn": "arn:aws:iam::257222191091:role/my-saloon-dev-api-task-role",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "ghcr.io/samitkumarpatel/multi-tenant-saloon:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "repositoryCredentials": {
        "credentialsParameter": "arn:aws:secretsmanager:eu-north-1:257222191091:secret:/my-saloon/dev/ghcr-token-JNPrIU"
      },
      "environment": [
        { "name": "spring.sql.init.mode",                                      "value": "never" },
        { "name": "spring.modulith.events.jdbc.schema-initialization.enabled", "value": "false" },
        { "name": "spring.flyway.enabled",                                      "value": "true" }
      ],
      "secrets": [
        { "name": "SPRING_DATASOURCE_URL",      "valueFrom": "arn:aws:secretsmanager:eu-north-1:257222191091:secret:/my-saloon/dev/db-url-2RXhV6" },
        { "name": "SPRING_DATASOURCE_USERNAME", "valueFrom": "arn:aws:secretsmanager:eu-north-1:257222191091:secret:/my-saloon/dev/db-username-lmhTRd" },
        { "name": "SPRING_DATASOURCE_PASSWORD", "valueFrom": "arn:aws:secretsmanager:eu-north-1:257222191091:secret:/my-saloon/dev/db-password-0vzkpi" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8080/actuator/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/my-saloon-dev/api",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
